source "https://rubygems.org"

gem "jekyll", "~> 4.4"

group :jekyll_plugins do
  gem "jekyll-feed", "~> 0.17"    # RSS/Atom feed for the blog
  gem "jekyll-sitemap", "~> 1.4"  # sitemap.xml for search engines
end

# Windows does not include zoneinfo files; tzinfo-data supplies them.
gem "tzinfo-data", platforms: [:mingw, :mswin, :x64_mingw, :jruby]

# Faster directory watching on Windows during `jekyll serve`.
gem "wdm", "~> 0.2.0", platforms: [:mingw, :mswin, :x64_mingw]
